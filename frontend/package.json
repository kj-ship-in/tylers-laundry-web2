{
  "name": "tylers-laundry-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"--no-deprecation\" next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "prettier --write",
    "type-check": "tsc --noEmit --skipLibCheck",
    "type-check:watch": "tsc --noEmit --skipLibCheck --watch",
    "check-all": "yarn type-check && yarn lint && yarn format:check",
    "fix-all": "yarn type-check && yarn lint:fix && yarn format",
    "clean:next": "rm -rf .next",
    "clean:out": "rm -rf out",
    "clean:build": "rm -rf .next out build dist",
    "clean:yarn-lock": "rm -rf yarn.lock",
    "clean:node-modules": "rm -rf node_modules",
    "clean:cache": "rm -rf .next/cache node_modules/.cache",
    "clean:all": "rm -rf node_modules yarn.lock .next out build dist",
    "clean:next:cache": "next build --no-lint && rm -rf .next/cache",
    "clean:eslint-cache": "rm -rf .eslintcache",
    "clean:typescript-cache": "rm -rf tsconfig.tsbuildinfo",
    "clean:full-cache": "yarn cache clean && rm -rf .next node_modules/.cache .eslintcache tsconfig.tsbuildinfo",
    "reset": "rm -rf node_modules yarn.lock && yarn install",
    "reset:hard": "yarn clean:all && yarn install",
    "fresh-start": "yarn clean:all && yarn cache clean && yarn install",
    "prebuild": "yarn lint"
  },
  "dependencies": {
    "@auth/nextjs": "^0.0.0-380f8d56",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.7",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.546.0",
    "next": "16.2.7",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-day-picker": "^9.11.2",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.66.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "3.6.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
